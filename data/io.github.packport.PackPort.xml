<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.appimage">
    <comment>AppImage application</comment>
    <glob pattern="*.AppImage" weight="80"/>
    <glob pattern="*.appimage" weight="70"/>
  </mime-type>
  <mime-type type="application/vnd.flatpak">
    <comment>Flatpak bundle</comment>
    <glob pattern="*.flatpak"/>
  </mime-type>
  <mime-type type="application/vnd.flatpak.ref">
    <comment>Flatpak reference</comment>
    <glob pattern="*.flatpakref"/>
  </mime-type>
</mime-info>

