[Desktop Entry]
Name=PackPort
Name[zh_CN]=PackPort 软件包安装器
Comment=Install local Linux application packages safely
Comment[zh_CN]=安全安装本地 Linux 应用软件包
Exec=packport %F
Icon=io.github.packport.PackPort
Terminal=false
Type=Application
Categories=Settings;PackageManager;GTK;
StartupNotify=true
MimeType=application/x-rpm;application/vnd.debian.binary-package;application/vnd.appimage;application/vnd.flatpak;application/vnd.flatpak.ref;
Keywords=package;installer;rpm;deb;appimage;flatpak;
